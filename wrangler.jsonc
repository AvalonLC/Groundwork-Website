{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-07-08",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Groundwork AI chat — first D1 database this project has (see
  // docs/ai-chatbot-architecture.md and migrations/0001_chat_schema.sql).
  //
  // Production database provisioned via .github/workflows/d1-setup.yml on
  // 2026-10-29 (real UUID below, confirmed via `wrangler d1 list`).
  // `--local` dev/preview mode (used by this sandbox and `npm run dev:d1`)
  // never calls Cloudflare's API for D1 regardless of this ID — it creates
  // a local SQLite file under .wrangler/state keyed by the binding name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groundwork-crm-marketing-production",
      "database_id": "8ec94323-04e8-4ec5-af2b-f623f4721aca"
    }
  ]
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}